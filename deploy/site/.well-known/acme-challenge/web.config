<?xml version="1.0" encoding="utf-8"?>
<!-- Let's Encrypt (ACME HTTP-01) proof files have no extension: serve them as plain text from this folder only. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension="." />
      <mimeMap fileExtension="." mimeType="text/plain" />
    </staticContent>
    <handlers>
      <clear />
      <add name="AcmeStaticFile" path="*" verb="GET,HEAD" modules="StaticFileModule" resourceType="Either" requireAccess="Read" />
    </handlers>
  </system.webServer>
</configuration>
