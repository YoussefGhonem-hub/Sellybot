<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- deploy.ps1 fills this in on the uploaded copy only (you type the database password when deploying). -->
    <add name="ChatDb" connectionString="PUT-DB-CONNECTION-HERE" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Secrets: deploy.ps1 fills these in on the uploaded copy only; they are never sent to browsers. -->
    <add key="AnthropicApiKey" value="PUT-ANTHROPIC-KEY-HERE" />
    <add key="AuthSecret" value="PUT-AUTH-SECRET-HERE" />
    <add key="AdminSignupCode" value="PUT-ADMIN-CODE-HERE" />
    <!-- Model and limits -->
    <add key="AnthropicModel" value="claude-haiku-5-5" />
    <add key="MaxReplyTokens" value="1500" />
    <!-- Monthly allowance for a new self-signed-up store, in cost-weighted tokens (~100+ replies). The admin can raise it per store. -->
    <add key="FreeMonthlyTokenLimit" value="300000" />
    <!-- Data size: up to FullModeMaxChars every reply sees all the data; above it the store uses search mode. MaxStoreChars is the hard cap per store. -->
    <add key="FullModeMaxChars" value="150000" />
    <add key="MaxStoreChars" value="5000000" />
    <!-- Database size limit in MB from the SmarterASP control panel (0 = unknown: then only a real "database full" error stops uploads). -->
    <add key="DbCapacityMB" value="1000" />
    <!-- Store ids nobody can sign up with (they look like parts of the site). "riwaq" keeps working from App_Data files until it is created in the dashboard. -->
    <add key="ReservedSlugs" value="admin,api,dashboard,www,app,pricing,support" />
    <add key="LegacyStore" value="riwaq" />
    <!-- The site's public address: http -> https, www -> no www, and the old *.ftempurl.com pages move here (widget.js and api/* keep working there). Empty = off. -->
    <add key="CanonicalHost" value="sellybot.online" />
  </appSettings>
  <system.web>
    <compilation targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="64" executionTimeout="180" enableVersionHeader="false" />
    <customErrors mode="RemoteOnly" />
  </system.web>
  <system.webServer>
    <!-- One public address (see CanonicalHost); preCondition="" so it also runs for static pages -->
    <modules>
      <add name="CanonicalHost" type="RiwaqChat.CanonicalHostModule" preCondition="" />
    </modules>
    <!-- Let browsers on store websites (Shopify etc.) do the CORS check (OPTIONS) against the chat API; the handler decides who is allowed. -->
    <handlers>
      <remove name="OPTIONSVerbHandler" />
      <remove name="SimpleHandlerFactory-Integrated-4.0" />
      <add name="SimpleHandlerFactory-Integrated-4.0" path="*.ashx" verb="GET,HEAD,POST,DEBUG,OPTIONS" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    <!-- Pages are never cached, so updates show up right away (widget.js gets its own short cache below). -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <!-- File uploads (up to 10 MB) and long text for the store data -->
  <location path="api/knowledge.ashx">
    <system.web>
      <httpRuntime maxRequestLength="12288" executionTimeout="300" />
    </system.web>
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="12582912" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
  <!-- The chat script that store websites load: cached 10 minutes (our own pages ask for it with a version number). -->
  <location path="widget.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:10:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="api/store.ashx">
    <system.web>
      <httpRuntime maxRequestLength="1024" />
    </system.web>
  </location>
  <!-- EasyOrders order webhooks (an order with its products can pass the 64 KB default) -->
  <location path="api/easyorders-webhook.ashx">
    <system.web>
      <httpRuntime maxRequestLength="1024" />
    </system.web>
  </location>
  <!--RUNTIME-->
</configuration>
