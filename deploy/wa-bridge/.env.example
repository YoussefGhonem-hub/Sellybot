# Copy to /opt/wa-bridge/.env on the server (chmod 600, owner wabridge). Never commit the real one.
BRIDGE_SECRET=change-me-48-random-letters-and-digits-xxxxxxxxxx
WEBHOOK_URL=https://sellybot.online/api/wa-webhook.ashx?src=bridge
PUBLIC_URL=https://wa.sellybot.online
DATA_DIR=/var/lib/wa-bridge
HOST=127.0.0.1
PORT=3100
MAX_INSTANCES=25
# optional: SEND_PER_MINUTE=20 SEND_PER_HOUR=400 SEND_GAP_MIN_MS=1200 SEND_GAP_MAX_MS=3500 BAILEYS_LOG=error LOG_LEVEL=info
